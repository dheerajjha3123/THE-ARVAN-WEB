# Database
DATABASE_URL="your_database_connection_string_here"

# Authentication
JWT_SECRET="your_jwt_secret_key_here"

# Frontend URL (set after frontend deployment)
FRONTENDURL="https://your-frontend-app.vercel.app"

# Server
PORT=3000

# Cloudinary (Optional - for image uploads)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ShipRocket (Optional - for shipping)
SHIPROCKET_EMAIL="your_shiprocket_email"
SHIPROCKET_PASSWORD="your_shiprocket_password"

# Google OAuth (Optional - for merchant features)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="your_google_redirect_uri"
GOOGLE_REFRESH_TOKEN="your_google_refresh_token"
GOOGLE_MERCHANT_ID="your_google_merchant_id"

# WhatsApp (Optional)
VERIFY_TOKEN="your_whatsapp_verify_token"

# Email (Optional - Resend service)
RESEND_API_KEY="your_resend_api_key"
